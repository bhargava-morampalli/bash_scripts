/*
========================================================================================
    nf-test Configuration
========================================================================================
    Configuration file for nf-test testing framework
----------------------------------------------------------------------------------------
*/

// nf-test configuration
params {
    // Test-specific parameters
    outdir = "tests/results"
}

// Enable plugins
plugins {
    id 'nf-validation'
}

// Profiles for testing
profiles {
    test {
        params {
            config_profile_name        = 'Test profile'
            config_profile_description = 'Minimal test dataset to check pipeline function'

            // Test data paths
            test_data_base = "${projectDir}/tests/data"
        }
    }

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
}

// Process configuration for tests
process {
    // Reduce resource requirements for tests
    cpus = 1
    memory = '2.GB'
    time = '1.h'
}

// Cleanup after tests
cleanup = true
