nextflow_process {

    name "Test Process SAMPLESHEET_CHECK"
    script "../main.nf"
    process "SAMPLESHEET_CHECK"

    tag "modules"
    tag "modules_local"
    tag "samplesheet_check"

    test("Should validate simple samplesheet successfully") {

        when {
            process {
                """
                input[0] = file("${projectDir}/tests/data/samplesheets/test_simple.csv", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should validate samplesheet with parameters") {

        when {
            process {
                """
                input[0] = file("${projectDir}/tests/data/samplesheets/test_with_params.csv", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should fail with invalid samplesheet - missing columns") {

        when {
            process {
                """
                input[0] = file("${projectDir}/tests/data/samplesheets/test_invalid.csv", checkIfExists: true)
                """
            }
        }

        then {
            assert process.failed
        }

    }

}
