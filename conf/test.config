/*
========================================================================================
    Test Configuration
========================================================================================
    Minimal test dataset configuration
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Limit resources for testing
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    // Input data - users should update this with their test data
    input       = 'assets/samplesheet_test.csv'

    // Genome size for testing (e.g., 4.5 Mb for E. coli transcriptome)
    genome_size = '4.5m'

    // Test with fewer coverage levels
    coverage_levels = '5,10,20,50,100'

    // Filtlong options
    min_length     = 500
    length_weight  = 10
}
